# ============================================================
# IntentLens — environment variable template
#
# Copy this file to .env and fill in the values marked REQUIRED.
# Never commit .env — it is in .gitignore.
# ============================================================

# ── Neo4j AuraDB ─────────────────────────────────────────────
# Create a free instance at https://console.neo4j.io
# On AuraDB free tier, username and database name are both
# the same 8-character instance ID (e.g. "228d5e41").
NEO4J_URI=neo4j+s://<instance-id>.databases.neo4j.io   # REQUIRED
NEO4J_USER=<instance-id>                                # REQUIRED  (same as instance ID)
NEO4J_PASSWORD=<your-auradb-password>                   # REQUIRED  (shown once at creation)
NEO4J_DATABASE=<instance-id>                            # REQUIRED  (same as instance ID)

# ── GitHub personal access token ─────────────────────────────
# Create at https://github.com/settings/tokens → Classic token
# Required scopes: public_repo (read-only is enough)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx   # REQUIRED for ingest

# ── Repo to analyse (defaults: redis/redis replication subsystem) ──
REPO_OWNER=redis
REPO_NAME=redis
REPO_LOCAL_PATH=data/repo
SUBSYSTEM_PATHS=src/replication.c,src/rdb.c,src/aof.c,redis.conf
MAX_PRS=400
MAX_COMMITS=3000

# ── LLM — NVIDIA API (OpenAI-compatible) ─────────────────────
# Endpoint: https://integrate.api.nvidia.com/v1
# Get your API key at https://build.nvidia.com → API Key
# Model used and verified: nvidia/nemotron-3-ultra-550b-a55b
LLM_BASE_URL=https://integrate.api.nvidia.com/v1       # REQUIRED
LLM_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx      # REQUIRED
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b             # REQUIRED
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3

# ── Embeddings (runs locally — no API key needed) ─────────────
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# ── Pipeline behaviour ────────────────────────────────────────
MAX_GRAPH_HOPS=3
REFUSAL_THRESHOLD=0.35
CACHE_DIR=data/cache

# ── CORS ─────────────────────────────────────────────────────
# Local dev: keep as-is
# Production: set to your Vercel URL (also set in Render dashboard)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Frontend API URL (production only) ───────────────────────
# Set VITE_API_BASE_URL in Vercel dashboard → Project → Environment Variables
# Value = your Render backend URL, e.g.:
# VITE_API_BASE_URL=https://intentlens-api.onrender.com
